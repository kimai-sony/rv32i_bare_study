{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "build",

            "type": "shell",

            "command": "cmake --build build",

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run",

            "detail": "Build and run in QEMU without debugging (Ctrl-A X to quit)",

            "dependsOn": [
                "build"
            ],

            "type": "shell",

            "command": "qemu-system-riscv32 -machine virt -bios none -kernel ${workspaceFolder}/build/hello -nographic",

            "problemMatcher": []
        },
        {
            "label": "qemu-gdb",

            "detail": "Build, then start QEMU halted with a GDB server on :1234",

            "dependsOn": [
                "build"
            ],
            "dependsOrder": "sequence",

            "type": "shell",

            "command": "[ -f ${workspaceFolder}/build/qemu.pid ] && kill $(cat ${workspaceFolder}/build/qemu.pid) 2>/dev/null; sleep 0.2; echo $$ > ${workspaceFolder}/build/qemu.pid; echo 'QEMU-GDB: STARTING'; sleep 0.1; echo 'QEMU-GDB: READY'; exec qemu-system-riscv32 -machine virt -bios none -kernel ${workspaceFolder}/build/hello -nographic -S -gdb tcp::1234",

            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },

            "isBackground": true,

            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },

            "problemMatcher": {
                "pattern": {
                    "regexp": "^QEMU-GDB-NEVER-MATCHES$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "QEMU-GDB: STARTING",
                    "endsPattern": "QEMU-GDB: READY"
                }
            }
        },
        {
            "label": "stop-qemu-gdb",

            "detail": "Kill the QEMU instance started by qemu-gdb",

            "type": "shell",

            "command": "[ -f ${workspaceFolder}/build/qemu.pid ] && kill $(cat ${workspaceFolder}/build/qemu.pid) 2>/dev/null; rm -f ${workspaceFolder}/build/qemu.pid",

            "presentation": {
                "reveal": "silent"
            },

            "problemMatcher": []
        }
    ]
}
